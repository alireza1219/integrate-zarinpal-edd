#: src/Admin/Settings.php:131
msgid "ZarinPal"
msgstr "زرین‌پال"

#: src/Admin/Settings.php:93
msgid "Enable ZarinGate"
msgstr "فعال‌سازی زرین‌گیت"

#: src/Admin/Settings.php:98
msgid "ZarinPal Merchant ID"
msgstr "شناسه مرچنت زرین‌پال"

#: src/Admin/Settings.php:99
msgid "Enter your ZarinPal Merchant ID here."
msgstr "شناسه مرچنت درگاه پرداخت زرین پال را در اینجا وارد کنید."

#: src/Gateway/API.php:115
msgid "Invalid ZarinPal API action provided!"
msgstr "عمل نامعتبری جهت ارتباط با API زرین‌پال ارسال شده است!"

#: src/Gateway/API.php:116
msgid "ZarinPal API Action Error"
msgstr "عمل نامعتبر API زرین‌پال"

#. translators: %s The current endpoint action.
#: src/Gateway/API.php:150
#, php-format
msgid "Making API request to %s endpoint"
msgstr "در حال ارسال درخواست به نقطه پایانی %s"

#: src/Gateway/API.php:185
msgid "ZarinPal API Request Failure"
msgstr "خطای درخواست API زرین‌پال"

#. translators: %d API HTTP response code.
#: src/Gateway/API.php:207
#, php-format
msgid "ZarinPal payment gateway returned HTTP status code %d"
msgstr "درگاه پرداخت زرین‌پال کد وضعیت %d HTTP را بازگرداند"

#: src/Gateway/API.php:210
msgid "ZarinPal API Status Error"
msgstr "خطای API زرین‌پال"

#: src/Gateway/API.php:227
msgid "Failed to decode ZarinPal API response"
msgstr "رمزگشایی پاسخ دریافت شده از API زرین‌پال با شکست مواجه شد"

#: src/Gateway/API.php:228
msgid "JSON Decode Error"
msgstr "خطای رمزگشایی JSON"

#. translators: %s Current API action.
#: src/Gateway/API.php:244
#, php-format
msgid "Request to %s ZarinPal endpoint succeeded"
msgstr "ارسال درخواست از نوع %s به API زرین‌پال با موفقیت انجام شد"

#: src/Gateway/Gateway.php:128
msgid "ZarinPal payment process has begun."
msgstr "درخواست پرداخت زرین‌پال آغاز شد."

#: src/Gateway/Gateway.php:139
msgid "ZarinPal payment process was stopped due to a nonce verification problem."
msgstr "درخواست پرداخت زرین‌پال به دلیل مشکل اعتبارسنجی Nonce متوقف شد."

#: src/Gateway/Gateway.php:142
msgid "Nonce verification has failed"
msgstr "عملیات اعتبارسنجی Nonce با شکست مواجه شد"

#: src/Gateway/Gateway.php:143
msgid "Error"
msgstr "خطا"

#: src/Gateway/Gateway.php:185
msgid "Order creation failed before ZarinPal payment request initialization."
msgstr "ساخت سفارش جدید پیش از ارسال درخواست به درگاه پرداخت زرین‌پال با شکست مواجه شد."

#: src/Gateway/Gateway.php:157 src/Gateway/Gateway.php:186
#: src/Gateway/Gateway.php:263 src/Gateway/Gateway.php:277
#: src/Gateway/Gateway.php:401 src/Helpers.php:82
msgid "ZarinPal Gateway Error"
msgstr "خطای درگاه پرداخت زرین‌پال"

#. translators: %1$s Order ID, %2$s: Customer name.
#: src/Gateway/Gateway.php:219
#, php-format
msgid "Order ID: %1$s, Customer Name: %2$s"
msgstr "شماره سفارش: %1$s، نام مشتری: %2$s"

#: src/Gateway/Gateway.php:262 src/Gateway/Gateway.php:276
msgid "There was an error while trying to connect to ZarinPal's API."
msgstr "هنگام تلاش برای اتصال به API زرین‌پال خطایی رخ داد."

#. translators: %1$s Error Code, %2$s: Parsed error message.
#: src/Gateway/Gateway.php:255 src/Gateway/Gateway.php:281
#: src/Gateway/Gateway.php:394
#, php-format
msgid "Error Code %1$s, %2$s"
msgstr "کد خطا %1$s، %2$s"

#: src/Gateway/Gateway.php:291
msgid "ZarinPal payment process has been completed successfully."
msgstr "درخواست پرداخت زرین‌پال با موفقیت به اتمام رسید."

#: src/Gateway/Gateway.php:317
msgid "ZarinPal payment verification has begun."
msgstr "اعتبارسنجی پرداخت زرین‌پال آغاز شد."

#: src/Gateway/Gateway.php:324
msgid "ZarinPal payment verification was stopped due to the missing required parameters."
msgstr "اعتبارسنجی پرداخت زرین‌پال متوقف شد، برخی از پارامترهای مورد نیاز تنظیم نشده‌اند."

#: src/Gateway/Gateway.php:342
msgid "ZarinPal payment verification was stopped due to a mismatch in the verification hash."
msgstr "اعتبارسنجی پرداخت زرین‌پال به دلیل وجود مشکل در هش بازگشتی از درگاه پرداخت، متوقف شد."

#: src/Gateway/Gateway.php:351
msgid "ZarinPal payment verification was stopped due to a missing order record."
msgstr "اعتبارسنجی پرداخت زرین‌پال متوقف شد، رکورد سفارش یافت نشد."

#: src/Gateway/Gateway.php:358
msgid "ZarinPal payment verification was stopped because the order is undergoing re-verification."
msgstr "اعتبارسنجی پرداخت زرین‌پال متوقف شد، سفارش در حال اعتبارسنجی مجدد است."

#: src/Gateway/Gateway.php:391
msgid "ZarinPal payment verification failed!"
msgstr "اعتبارسنجی پرداخت زرین‌پال با شکست مواجه شد!"

#: src/Gateway/Gateway.php:414
msgid "ZarinPal payment verification has been completed successfully."
msgstr "اعتبارسنجی پرداخت زرین‌پال با موفقیت انجام شد."

#. translators: %1$s Reference ID, %2$s: Authority.
#: src/Gateway/Gateway.php:428
#, php-format
msgid "ZarinPal payment was successful. Reference ID: %1$s, Authority: %2$s."
msgstr "پرداخت زرین‌پال موفقیت‌آمیز بود. شماره مرجع: %1$s، شماره آتوریتی: %2$s."

#: src/Helpers.php:59 src/Helpers.php:87
msgid "Context"
msgstr "اطلاعات بیشتر"

#: src/Helpers.php:146
msgid "Not Available"
msgstr "در دسترس نیست"

#: src/Helpers.php:165
msgid "Incomplete information provided."
msgstr "اطلاعات ارسال شده ناقص است."

#: src/Helpers.php:170
msgid "There was a validation error."
msgstr "خطای اعتبارسنجی رخ داده است."

#: src/Helpers.php:171
msgid "Terminal is not valid. Please check your Merchant ID or IP address."
msgstr "شناسه مرچنت یا آدرس IP شما معتبر نمی‌باشد. لطفاً نسبت به تصحیح کردن آن اقدام کنید."

#: src/Helpers.php:172
msgid "Terminal is not active. Please contact our support team."
msgstr "شناسه مرچنت شما فعال نمی‌باشد. لطفاً مشکل خود را به امور مشتریان زرین‌پال ارجاع دهید."

#: src/Helpers.php:173
msgid "Too many attempts, please try again later."
msgstr "تلاش‌ها بیش از دفعات مجاز تعیین شده در یک بازه زمانی می‌باشد. لطفاً کمی بعد تلاش کنید."

#: src/Helpers.php:176
msgid "Terminal user is suspended."
msgstr "درگاه پرداخت شما به حالت تعلیق درآمده است. لطفاً مشکل خود را به امور مشتریان زرین‌پال ارجاع دهید."

#: src/Helpers.php:177 src/Helpers.php:178
msgid "Terminal user level is not valid."
msgstr "مشکلی در سطح تأیید پذیرنده وجود دارد. لطفاً مشکل خود را به امور مشتریان زرین‌پال ارجاع دهید."

#: src/Helpers.php:181
msgid "No financial operation found for this transaction."
msgstr "هیچ نوع عملیات مالی برای این تراکنش یافت نشد."

#: src/Helpers.php:182
msgid "The transaction has been unsuccessful."
msgstr "تراکنش ناموفق می‌باشد."

#: src/Helpers.php:183
msgid "Transaction amount does not match the paid amount."
msgstr "مبلغ تراکنش با مبلغ پرداخت شده مطابقت ندارد."

#: src/Helpers.php:184
msgid "The transaction has reached the limit for the number or amount of divisions."
msgstr "سقف تقسیم تراکنش از لحاظ تعداد یا رقم عبور نموده است."

#: src/Helpers.php:185 src/Helpers.php:191
msgid "An unexpected error has occurred. Please get in touch with the ZarinPal's customer care."
msgstr "خطای نامشخصی رخ داده است. لطفاً با امور مشتریان زرین‌پال تماس بگیرید."

#: src/Helpers.php:188
msgid "The valid lifespan of the payment ID must be between 30 minutes to 45 days."
msgstr "مدت زمان معتبر طول عمر شناسه پرداخت باید بین ۳۰ دقیقه تا ۴۵ روز باشد."

#: src/Helpers.php:189
msgid "The amount paid is different from the amount sent in the verification method."
msgstr "مبلغ پرداخت شده با مبلغ ارسال شده از سوی متد اعتبارسنجی متفاوت است."

#: src/Helpers.php:190
msgid "Failed payment."
msgstr "پرداخت با شکست مواجه شده است."

#: src/Helpers.php:192
msgid "The payment does not belong to this merchant code."
msgstr "پرداخت فوق به شناسه مرچنت ارسال شده تعلق ندارد."

#: src/Helpers.php:193
msgid "Invalid authority."
msgstr "آتوریتی (Authority) نامعتبر است."

#: src/Helpers.php:199
msgid "The operation was successful."
msgstr "عملیات با موفقیت انجام گردیده است."

#: src/Helpers.php:200
msgid "The payment operation was successful, and the payment verification for the transaction has been done before."
msgstr "عملیات پرداخت موفق بوده و اعتبارسنجی تراکنش قبلاً صورت گرفته است."

#: src/Helpers.php:208
msgid "An unknown error occurred while connecting to the ZarinPal gateway."
msgstr "خطای نامشخصی هنگام اتصال به درگاه زرین‌پال رخ داده است."

#: src/Gateway/Gateway.php:156
msgid "Integrate ZarinPal for EDD does not support recurring items in cart."
msgstr "درگاه پرداخت زرین‌پال برای EDD از آیتم‌های اشتراکی در سبد خرید پشتیبانی نمی‌کند."

#: src/Helpers.php:166
msgid "The callback url is not valid."
msgstr "آدرس بازگشت (callback_url) ارسال شده، نامعتبر است."

#: src/Helpers.php:167
msgid "Description is more than 500 characters."
msgstr "پارامتر توضیحات (description) نباید بیشتر از ۵۰۰ کاراکتر باشد."

#: src/Helpers.php:168
msgid "The payment amount is not valid."
msgstr "مبلغ ارسال شده نامعتبر است."

#: src/Helpers.php:169
msgid "The referer ID is not valid."
msgstr "کد معرف ارسال شده (referrer_id) نامعتبر است."

#: src/Helpers.php:174
msgid "Terminal limit reached."
msgstr "برای شما محدودیت تراکنش ایجاد شده است. جهت تکمیل مدارک خود با پشتیبانی زرین‌پال در تماس باشید."

#: src/Helpers.php:175
msgid "The callback URL domain does not match the registered terminal domain."
msgstr "دامنه آدرس بازگشت (callback_url) شما با دامنه ثبت شده بر روی درگاه شما، مغایرت دارد."

#: src/Helpers.php:179
msgid "The referrer address does not match the registered domain."
msgstr "شما امکان استفاده از کد درگاه اختصاصی خود بر روی سایت یا مکان دیگری را ندارید."

#: src/Helpers.php:180
msgid "Terminal user transactions are banned."
msgstr "امکان ایجاد تراکنش برای این ترمینال امکان‌پذیر نیست."

#: src/Helpers.php:186
msgid "Invalid extra params, expire_in is not valid."
msgstr "پارامتر expire_in نامعتبر است."

#: src/Helpers.php:187
msgid "The maximum valid amount per payment is 100,000,000 Toman."
msgstr "حدأکثر مبلغ پرداختی برابر با ۱۰۰ میلیون تومان است."

#: src/Helpers.php:194
msgid "The payment request was not found."
msgstr "تراکنش مورد نظر شما یافت نشد."

#: src/Helpers.php:195
msgid "Session can not be reversed with bank."
msgstr "امکان ریورس کردن تراکنش با بانک وجود ندارد."

#: src/Helpers.php:196
msgid "Session was not successful or is reversed before."
msgstr "تراکنش موفقیت‌آمیز نبوده یا از قبل ریورس شده است."

#: src/Helpers.php:197
msgid "The terminal IP address is not set."
msgstr "آدرس آی‌پی برای درگاه شما تنظیم نشده است."

#: src/Helpers.php:198
msgid "The maximum time allowed to reverse this transaction has elapsed."
msgstr "حدأکثر زمان (۳۰ دقیقه) برای ریورس کردن این تراکنش منقضی شده است."
