#. Plugin Name of the plugin
#: integrate-zarinpal-edd.php
msgid "Integrate ZarinPal for EDD"
msgstr "ادغام درگاه پرداخت زرین‌پال برای EDD"

#. Plugin URI of the plugin
#: integrate-zarinpal-edd.php
msgid "https://wordpress.org/plugins/integrate-zarinpal-edd"
msgstr "https://wordpress.org/plugins/integrate-zarinpal-edd"

#. Description of the plugin
#: integrate-zarinpal-edd.php
msgid "Zarinpal integration for Easy Digital Downloads."
msgstr "درگاه پرداخت زرین‌پال را با پلتفرم محبوب Easy Digital Downloads یکپارچه کنید."

#. Author of the plugin
#: integrate-zarinpal-edd.php
msgid "Alireza Barani"
msgstr "علیرضا بارانی"

#. Author URI of the plugin
#: integrate-zarinpal-edd.php
msgid "https://alireza1219.ir"
msgstr "https://alireza1219.ir"

